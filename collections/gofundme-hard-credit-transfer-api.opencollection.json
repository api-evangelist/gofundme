            "params": [
              {
                "name": "transaction",
                "value": "",
                "type": "path",
                "description": "Primary identifier of specified Transaction"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Creates a Hard Credit Transfer for the specified Transaction, thereby re-attributing it to the new Fundraising Entity"
        }
      ]
    }
  ],
  "bundled": true
}