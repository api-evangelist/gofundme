{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Hard Credit Transfer API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Hard Credit Transfer",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "createHardCreditTransfer",
            "type": "http"
          },
