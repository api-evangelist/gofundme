{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Soft Credit API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "SoftCredit",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listCampaignSoftCredits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/soft-credits",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "ID of Campaign"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "List Campaign Soft Credits"
        },
        {
          "info": {
            "name": "listFundraisingPageSoftCredits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/fundraising-pages/:fundraising_page/soft-credits",
            "params": [
              {
                "name": "fundraising_page",
                "value": "",
                "type": "path",
                "description": "ID of Fundraising Page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "List Fundraising Page Soft Credits"
        },
        {
          "info": {
            "name": "listFundraisingTeamSoftCredits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/fundraising-teams/:fundraising_team/soft-credits",
            "params": [
              {
                "name": "fundraising_team",
                "value": "",
                "type": "path",
                "description": "ID of Fundraising Team"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "List Fundraising Team Soft Credits"
        }
      ]
    }
  ],
  "bundled": true
}