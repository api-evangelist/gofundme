{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Promo Code API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Promo Code",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listCampaignPromoCodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/promo-codes",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "Primary identifier of specified Campaign"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "Retrieves a list of all Promo Codes made for the specified Campaign"
        },
        {
          "info": {
            "name": "createCampaignPromoCode",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/promo-codes",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "Primary identifier of specified Campaign"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create Promo Code for the specified Campaign"
        },
        {
          "info": {
            "name": "fetchPromoCode",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/promo-codes/:promo_code",
            "params": [
              {
                "name": "promo_code",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Promo Code"
              }
            ]
          },
          "docs": "Fetch specified Promo Code"
        },
        {
          "info": {
            "name": "updatePromoCode",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/promo-codes/:promo_code",
            "params": [
              {
                "name": "promo_code",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Promo Code"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Update a Promo Code"
        },
        {
          "info": {
            "name": "listTicketTypesPromoCodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/ticket-types/:ticket_type/promo-codes",
            "params": [
              {
                "name": "ticket_type",
                "value": "",
                "type": "path",
                "description": "Primary identifier of specified Ticket Type"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "Retrieves a list of all Promo Codes made for the specified Ticket Type"
        }
      ]
    }
  ],
  "bundled": true
}