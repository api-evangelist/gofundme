{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Donation Matching Plan API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Donation Matching Plan",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listCampaignDonationMatchingPlans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/donation-matching-plans",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Donation Matching Plan"
              }
            ]
          },
          "docs": "Retrieves a list of all Donation Matching Plans for specified Campaign"
        },
        {
          "info": {
            "name": "createDonationMatchingPlan",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/donation-matching-plans",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Donation Matching Plan"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a Donation Matching Plan for specified Campaign"
        },
        {
          "info": {
            "name": "fetchDonationMatchingPlan",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/donation-matching-plans/:donation_matching_plan",
            "params": [
              {
                "name": "donation_matching_plan",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Donation Matching Plan"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Fetch specified Donation Matching Plan"
        },
        {
          "info": {
            "name": "updateDonationMatchingPlan",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/donation-matching-plans/:donation_matching_plan",
            "params": [
              {
                "name": "donation_matching_plan",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Donation Matching Plan"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a Donation Matching Plan"
        }
      ]
    }
  ],
  "bundled": true
}