{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro GFM NPO Page API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "GFM NPO Page",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update NPO page profile information",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The organization ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the GoFundMe NPO page profile information for an organization"
        },
        {
          "info": {
            "name": "Update charity settings",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/settings",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The organization ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the GoFundMe charity settings for an organization"
        },
        {
          "info": {
            "name": "Update charity include default photos setting",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/include-default-photos",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The organization ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates whether the charity includes default photos"
        },
        {
          "info": {
            "name": "Update charity NPO Profile opt-in",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/npo-profile-opt-in",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The organization ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets whether the charity has opted into the redesigned NPO profile experience."
        },
        {
          "info": {
            "name": "Update GFM Pro account status",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/pro-status",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The organization ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the GoFundMe Pro status for the organization's NPO account."
        },
        {
          "info": {
            "name": "Update charity fundraiser photo status",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/photo-status",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The organization ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the status of a charity fundraiser photo"
        },
        {
          "info": {
            "name": "Upload image to GFM NPO page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/upload-image",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The organization ID"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "photoType",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Creates a presigned URL, uploads the file to S3, and finalizes the image in the GFM brand kit."
        },
        {
          "info": {
            "name": "Download Fundraisers Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/download-fundraisers-report",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Organization"
              },
              {
                "name": "environment",
                "value": "",
                "type": "query",
                "description": "Environment to download from"
              }
            ]
          },
          "docs": "Downloads the most recent fundraisers report CSV file for an organization"
        },
        {
          "info": {
            "name": "Download Donations Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/download-donations-report",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Organization"
              },
              {
                "name": "environment",
                "value": "",
                "type": "query",
                "description": "Environment to download from"
              }
            ]
          },
          "docs": "Downloads the most recent donations report CSV file for an organization"
        }
      ]
    }
  ],
  "bundled": true
}