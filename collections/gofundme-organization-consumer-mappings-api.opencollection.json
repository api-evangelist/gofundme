{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Organization Consumer Mappings API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization Consumer Mappings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a new organization consumer mapping",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/consumer-charity-mappings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Store a new organization consumer mapping"
        },
        {
          "info": {
            "name": "Get a specific organization consumer mapping",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/consumer-charity-mappings/:consumer_charity_mapping",
            "params": [
              {
                "name": "consumer_charity_mapping",
                "value": "",
                "type": "path",
                "description": "Mapping ID"
              }
            ]
          },
          "docs": "Show a specific organization consumer mapping"
        },
        {
          "info": {
            "name": "Update an organization consumer mapping",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/consumer-charity-mappings/:consumer_charity_mapping",
            "params": [
              {
                "name": "consumer_charity_mapping",
                "value": "",
                "type": "path",
                "description": "Mapping ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an organization consumer mapping"
        },
        {
          "info": {
            "name": "Delete an organization consumer mapping",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://pro.gofundme.com/api/2.0/consumer-charity-mappings/:consumer_charity_mapping",
            "params": [
              {
                "name": "consumer_charity_mapping",
                "value": "",
                "type": "path",
                "description": "Mapping ID"
              }
            ]
          },
          "docs": "Delete an organization consumer mapping"
        },
        {
          "info": {
            "name": "Set a mapping as the primary for its consumer charity ID",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/consumer-charity-mappings/:id/set-primary",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Mapping ID to set as primary"
              }
            ]
          },
          "docs": "Switch the primary mapping for a consumer charity ID"
        }
      ]
    }
  ],
  "bundled": true
}