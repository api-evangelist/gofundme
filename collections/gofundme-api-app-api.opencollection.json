{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro API App API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "API App",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "fetchClientProfile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/apps/:app",
            "params": [
              {
                "name": "app",
                "value": "",
                "type": "path",
                "description": "The specified Client ID"
              }
            ]
          },
          "docs": "Show the Profile for a given Client"
        }
      ]
    }
  ],
  "bundled": true
}