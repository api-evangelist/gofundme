      "items": [
        {
          "info": {
            "name": "Send Annual Summary Email to Supporter (Admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/supporters/:supporter_id/annual-summary",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The specified Organization ID"
              },
              {
                "name": "supporter_id",
                "value": "",
                "type": "path",
                "description": "The specified Supporter ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Send an annual summary email to a specific supporter. This is an admin-initiated action that does not require a bulk batch send."
        },
        {
          "info": {
            "name": "Generate Annual Summary Report for Supporter",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/supporters/:supporter_id/annual-summary",
            "params": [
              {
                "name": "supporter_id",
                "value": "",
                "type": "path",
                "description": "The specified Supporter ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate an annual summary report PDF for the specified supporter and return a presigned S3 URL for download"
        },
