{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Organization Channel API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization Channel",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listOrganizationChannel",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization/channels",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Organization"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "Retrieves a list of all Channels for the specified Organization"
        },
        {
          "info": {
            "name": "disableOrganizationChannel",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/organization-channels/:id/disable",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Organization Channel"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Disables a Channel for the specified Organization"
        }
      ]
    }
  ],
  "bundled": true
}