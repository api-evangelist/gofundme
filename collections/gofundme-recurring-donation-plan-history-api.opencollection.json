{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Recurring Donation Plan History API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Recurring Donation Plan History",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listRecurringDonationPlanHistory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/recurring-donation-plans/:recurring_donation_plan/history",
            "params": [
              {
                "name": "recurring_donation_plan",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Recurring Donation Plan"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "List the history for a Recurring Donation Plan"
        },
        {
          "info": {
            "name": "listOrganizationRecurringDonationPlanHistory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization/recurring-donation-history",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Organization"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "Retrieve a list of all the Recurring Donation Plan History for the given organization."
        }
      ]
    }
  ],
  "bundled": true
}