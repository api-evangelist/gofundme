{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Ticket Type API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Ticket Type",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listCampaignTicketTypes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/ticket-types",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Campaign"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "Get Ticket Types for a given Campaign."
        },
        {
          "info": {
            "name": "createTicketType",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/ticket-types",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Campaign"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a Ticket Type for a given Campaign."
        },
        {
          "info": {
            "name": "listOrganizationTicketTypes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization/ticket-types",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Organization"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "Retrieve a list of all the Ticket Types for the given Organization."
        },
        {
          "info": {
            "name": "listPromoCodeTicketTypes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/promo-codes/:promo_code/ticket-types",
            "params": [
              {
                "name": "promo_code",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Promo Code"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "List all Ticket Types configured to work with the specified Promo Code"
        },
        {
          "info": {
            "name": "fetchTicketType",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/ticket-types/:ticket_type",
            "params": [
              {
                "name": "ticket_type",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Ticket Type"
              }
            ]
          },
          "docs": "Fetch a single Ticket Type resource."
        },
        {
          "info": {
            "name": "updateTicketType",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/ticket-types/:ticket_type",
            "params": [
              {
                "name": "ticket_type",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Ticket Type"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Update a single Ticket Type resource."
        }
      ]
    }
  ],
  "bundled": true
}