{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Reports API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download Fundraisers Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/download-fundraisers-report",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Organization"
              },
              {
                "name": "environment",
                "value": "",
                "type": "query",
                "description": "Environment to download from"
              }
            ]
          },
          "docs": "Downloads the most recent fundraisers report CSV file for an organization"
        },
        {
          "info": {
            "name": "Download Donations Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization_id/gfm-npo-page/download-donations-report",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Organization"
              },
              {
                "name": "environment",
                "value": "",
                "type": "query",
                "description": "Environment to download from"
              }
            ]
          },
          "docs": "Downloads the most recent donations report CSV file for an organization"
        }
      ]
    }
  ],
  "bundled": true
}