{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Campaign Credential Set API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Campaign Credential Set",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listCampaignCredentialSets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/credential-sets",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "The specified Campaign ID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "Retrieves a list of all Credential Sets for the specified Campaign"
        },
        {
          "info": {
            "name": "createCampaignCredentialSet",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/credential-sets",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "The specified Campaign ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Credential Set for specified Campaign"
        },
        {
          "info": {
            "name": "fetchCampaignCredentialSet",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/campaign-credential-sets/:campaign_credential_set",
            "params": [
              {
                "name": "campaign_credential_set",
                "value": "",
                "type": "path",
                "description": "The specified Campaign Credential Set ID"
              }
            ]
          },
          "docs": "Retrieves a Campaign Credential Set from ID"
        },
        {
          "info": {
            "name": "deleteCampaignCredentialSet",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://pro.gofundme.com/api/2.0/campaign-credential-sets/:campaign_credential_set",
            "params": [
              {
                "name": "campaign_credential_set",
                "value": "",
                "type": "path",
                "description": "Campaign Credential Set ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Delete a specified Campaign Credential Set"
        }
      ]
    }
  ],
  "bundled": true
}