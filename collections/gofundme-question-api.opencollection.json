{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoFundMe Pro Question API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth2/auth",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Question",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listCampaignQuestions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/questions",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "The specified Campaign ID"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to be returned"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves a list of all questions for a specific Campaign. Questions marked as `is_required: true` will be treated as pre-conversion (shown before donation), and those marked as `is_required: false` will be treated as post-conversion (shown after donation) only where supported."
        },
        {
          "info": {
            "name": "createCampaignQuestion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pro.gofundme.com/api/2.0/campaigns/:campaign/questions",
            "params": [
              {
                "name": "campaign",
                "value": "",
                "type": "path",
                "description": "The ID of the campaign to which the question will be added"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a new question for a specific campaign. Questions marked as required will automatically be treated as pre-conversion (where supported)."
        },
        {
          "info": {
            "name": "listOrganizationQuestions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/organizations/:organization/questions",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The specified Organization ID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Indicator of which page of results to return"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of entries to return in each page of results"
              }
            ]
          },
          "docs": "Retrieves a list of all questions for a specific Organization"
        },
        {
          "info": {
            "name": "fetchQuestion",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro.gofundme.com/api/2.0/questions/:question",
            "params": [
              {
                "name": "question",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Question"
              }
            ]
          },
          "docs": "Fetch specified Question"
        },
        {
          "info": {
            "name": "updateQuestion",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pro.gofundme.com/api/2.0/questions/:question",
            "params": [
              {
                "name": "question",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Question"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Update a Question"
        },
        {
          "info": {
            "name": "deleteQuestion",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://pro.gofundme.com/api/2.0/questions/:question",
            "params": [
              {
                "name": "question",
                "value": "",
                "type": "path",
                "description": "Primary identifier of Question"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/oauth2/auth",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Delete Question"
        }
      ]
    }
  ],
  "bundled": true
}